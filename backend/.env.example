# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/pizza-app

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Email (Nodemailer - use Gmail or Mailtrap for dev)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@pizzaapp.com
ADMIN_EMAIL=admin@pizzaapp.com

# Razorpay (Test Mode Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend URL (for email links)
FRONTEND_URL=https://pizza-app-eight-sable.vercel.app/

# Inventory thresholds
STOCK_THRESHOLD=20
